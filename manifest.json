{
  "manifest_version": 3,
  "name": "Basta Job Assistant",
  "version": "1.0.0",
  "description": "Collects job information from LinkedIn, ZipRecruiter, Indeed, and Handshake",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.indeed.com/*",
    "https://*.joinhandshake.com/*",
    "https://*.app.joinhandshake.com/*",
    "https://staging-seekr-adaptive-api.projectbasta.com/*",
    "https://aoi-hackathon.projectbasta.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*",
        "https://*.ziprecruiter.com/*",
        "https://*.indeed.com/*",
        "https://*.joinhandshake.com/*",
        "https://*.app.joinhandshake.com/*"
      ],
      "js": ["content/process.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

